<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore from nuget.org only, whatever feeds the machine has configured, so the build is the same
  for everyone who clones the repository.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
