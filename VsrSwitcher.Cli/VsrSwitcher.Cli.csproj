<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>vsrswitch</AssemblyName>
    <RootNamespace>VsrSwitcher.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyTitle>VSR Switcher command line</AssemblyTitle>
    <Description>Command-line control of NVIDIA RTX Video Super Resolution.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VsrSwitcher.Core\VsrSwitcher.Core.csproj" />
  </ItemGroup>

</Project>
